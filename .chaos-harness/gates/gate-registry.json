{
  "gates": [
    {
      "id": "gate-requirements",
      "type": "stage",
      "stage": "requirements",
      "level": "hard",
      "description": "需求阶段 — 需求文档/PRD 存在",
      "trigger": "stage-transition",
      "cachePolicy": "on-change",
      "validators": [
        { "type": "file-exists", "path": "output/*/requirements" }
      ],
      "dependsOn": []
    },
    {
      "id": "gate-implementation",
      "type": "stage",
      "stage": "implementation",
      "level": "hard",
      "description": "实现阶段 — 代码无语法错误且有提交",
      "trigger": "stage-transition",
      "cachePolicy": "on-change",
      "validators": [
        { "type": "no-syntax-errors" },
        { "type": "git-has-commits", "minCommits": 1 }
      ],
      "dependsOn": ["gate-requirements"]
    },
    {
      "id": "gate-release",
      "type": "stage",
      "stage": "release",
      "level": "hard",
      "description": "发布阶段 — 测试全部通过",
      "trigger": "stage-transition",
      "cachePolicy": "on-change",
      "validators": [
        { "type": "test-suite-pass" }
      ],
      "dependsOn": ["gate-implementation"]
    },
    {
      "id": "gate-quality",
      "type": "quality",
      "level": "hard",
      "description": "质量门 — 铁律合规 + 测试通过（合并 iron-law/tests/format）",
      "trigger": "pre-write",
      "cachePolicy": "never",
      "validators": [
        { "type": "iron-law-check" }
      ],
      "dependsOn": []
    },
    {
      "id": "gate-intelligence",
      "type": "quality",
      "level": "soft",
      "description": "智能建议 — 基于 Wiki 推荐模式与反模式",
      "trigger": "stage-transition",
      "cachePolicy": "on-change",
      "validators": [
        {
          "type": "script",
          "script": "dev-intelligence.mjs",
          "args": ["--auto-check", "--stage", "{current_stage}"]
        }
      ],
      "dependsOn": []
    }
  ],
  "version": "1.4.0",
  "createdAt": "2026-06-29T00:00:00Z"
}
